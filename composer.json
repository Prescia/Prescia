{
  "name": "leohmoraes/prescia",
  "description": "Prescia framework",
  "license": "BSD-3-Clause",
  "type": "project",
  "require": {
    "php": ">=8.3 <8.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "Prescia\\Services\\": "prescia/services/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Prescia\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "analyse:baseline": "phpstan analyse --configuration=phpstan.neon.dist --generate-baseline=phpstan-baseline.neon --no-progress",
    "migrate:php83": "php tools/migrate_php83.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
